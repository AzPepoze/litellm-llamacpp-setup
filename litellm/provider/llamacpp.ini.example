# llama.cpp provider endpoints for LiteLLM auto-sync (litellm/sync-models.sh).
# Copy to llamacpp.ini and fill in real values. llamacpp.ini is git-ignored.
#
# One [section] per llama.cpp server. The section name is only a label.
# NOTE: this file is read INSIDE the litellm container, so base_url must be
# reachable FROM that container. `localhost` does NOT work there — use the
# server's LAN hostname or IP.

[example]
base_url = http://example:8080/v1
api_key = sk-change-me
# model_prefix = example-
