# Model weights and HuggingFace cache (entire directory recursively)
/models/
models/
models/**/*
*.gguf

# Environment variables and secrets
.env
.env.*
!.env.example

# llama.cpp presets (real config ignored, template tracked)
llama-cpp/presets.ini
!llama-cpp/presets.ini.example

# llama.cpp provider endpoints (real list ignored, template tracked)
litellm/provider/*.ini
!litellm/provider/*.ini.example

# LiteLLM runtime config (generated in-container at startup from config.template.yaml)
litellm/config.yaml

# LiteLLM sync state (which models are already registered; local only)
litellm/state/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.sup
*.swp
*~
